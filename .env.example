# ---------------------------------------------------------------------------
# LLM Usage Metering & Billing Engine - environment template
# Copy to `.env` and adjust. NEVER commit the real `.env` (see .gitignore).
# All monetary values are MICRO-CENTS (integer): $1.00 USD = 1_000_000 micro-cents
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=llm-metering-engine
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/v1

# --- HTTP server ---------------------------------------------------------
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=1
UVICORN_RELOAD=false

# --- PostgreSQL 16 ----------------------------------------------------------
# Host port is overridable so the stack never collides with an existing PG.
POSTGRES_USER=metering
POSTGRES_PASSWORD=metering
POSTGRES_DB=metering
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://metering:metering@localhost:5432/metering
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false
AUTO_MIGRATE=true
AUTO_SEED=true

# --- Redis 7 ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TTL_SECONDS=300
REDIS_IDEMPOTENCY_TTL_SECONDS=86400
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_SOCKET_TIMEOUT=5

# --- Stripe (TEST MODE) -----------------------------------------------------
# Use your own Stripe test-mode keys: https://dashboard.stripe.com/test/apikeys
# `stripe listen --forward-to localhost:8000/v1/webhooks/stripe` prints the whsec_...
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2024-06-20
STRIPE_PRICE_PRO=price_replace_me_pro
STRIPE_PRICE_FREE=price_replace_me_free
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# --- AWS S3 / LocalStack audit archiving ------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=llm-metering-audit
S3_PREFIX=audit
S3_ADDRESSING_STYLE=path
AUDIT_FLUSH_INTERVAL_SECONDS=3600
AUDIT_BATCH_SIZE=500
AUDIT_ENABLED=true

# --- Plan quotas (micro-cents) ---------------------------------------------
FREE_PLAN_CODE=free
PRO_PLAN_CODE=pro
# Free  = $5.00   -> 5_000_000
# Pro   = $500.00 -> 500_000_000
FREE_MONTHLY_LIMIT_MICROCENTS=5000000
PRO_MONTHLY_LIMIT_MICROCENTS=500000000
# 0 == unlimited spend (rate limit still applies)
FREE_RATE_LIMIT_RPM=60
PRO_RATE_LIMIT_RPM=600
# Cached-input tokens are billed at 25% of the standard input rate.
CACHED_INPUT_DISCOUNT_BPS=2500
# When true, `output_tokens` already contains `reasoning_tokens` (OpenAI semantics).
REASONING_INCLUDED_IN_OUTPUT=true

# --- ML anomaly guard (IsolationForest) -------------------------------------
ML_GUARD_ENABLED=true
ML_CONTAMINATION=0.05
ML_MIN_SAMPLES=32
ML_WINDOW_SIZE=512
ML_REFIT_INTERVAL=16
ML_SCORE_THRESHOLD=0.0
ML_MAX_TOKENS_PER_REQUEST=400000
ML_MAX_STEPS_PER_REQUEST=50

# --- Observability ----------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH=/metrics
LOG_JSON=true
